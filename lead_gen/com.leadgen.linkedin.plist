<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.leadgen.linkedin</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/ashishkattamuri/Documents/linkedin_lead_gen_automation/prom_lead_generator_cb/lead_gen/main_linkedin.py</string>
    </array>

    <!-- Run every day at 10:00 AM local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/ashishkattamuri/Desktop/lead_generation_runs/linkedin_run.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/ashishkattamuri/Desktop/lead_generation_runs/linkedin_error.log</string>

    <!-- Run even if the scheduled time was missed (e.g. laptop was asleep) -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
